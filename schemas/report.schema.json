{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Report",
  "description": "Final structured report — only reachable, deduped findings.",
  "type": "object",
  "required": ["run_id", "target", "summary", "findings"],
  "additionalProperties": false,
  "properties": {
    "run_id": { "type": "string" },
    "target": {
      "type": "object",
      "required": ["repo_path"],
      "additionalProperties": false,
      "properties": {
        "repo_path": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total", "by_severity"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_severity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "critical":      { "type": "integer", "minimum": 0 },
            "high":          { "type": "integer", "minimum": 0 },
            "medium":        { "type": "integer", "minimum": 0 },
            "low":           { "type": "integer", "minimum": 0 },
            "informational": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "title", "severity", "vuln_class", "file", "line_start", "line_end", "description", "evidence", "trace", "recommendation"],
        "additionalProperties": false,
        "properties": {
          "finding_id": { "type": "string" },
          "title": { "type": "string", "minLength": 5 },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "informational"] },
          "vuln_class": { "type": "string" },
          "cwe": { "type": "string", "pattern": "^CWE-[0-9]+$" },
          "file": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "description": { "type": "string", "minLength": 30 },
          "evidence": { "type": "string" },
          "trace": {
            "type": "object",
            "required": ["entry_points", "call_chain"],
            "additionalProperties": false,
            "properties": {
              "entry_points": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "location"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "type": "string" },
                    "location": { "type": "string" },
                    "controllable_by": { "type": "string" }
                  }
                }
              },
              "call_chain": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["file", "function", "line"],
                  "additionalProperties": false,
                  "properties": {
                    "file": { "type": "string" },
                    "function": { "type": "string" },
                    "line": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          "poc": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "language": { "type": "string" },
              "code": { "type": "string" },
              "succeeded": { "type": "boolean" }
            }
          },
          "variants": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Other finding_ids in the same dedupe group."
          },
          "recommendation": { "type": "string", "minLength": 20 }
        }
      }
    },
    "chains": {
      "type": "array",
      "description": "Multi-step exploit chains (V11) — combinations of >=2 findings more dangerous than any single bug. Each chain carries its OWN severity; per-finding severities are unchanged (CVSS/V4 stays authoritative). Injected from the run state by report.py.",
      "items": {
        "type": "object",
        "required": ["title", "finding_ids", "severity", "narrative"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "finding_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "blocked_by_controls": { "type": "array", "items": { "type": "string" } },
          "narrative": { "type": "string" }
        }
      }
    },
    "input_inventory": {
      "type": "array",
      "description": "Resolved completeness ledger — every attacker-controllable input Recon enumerated, each with its reconciled disposition (covered|uncovered). Injected from the run state by report.py; a completeness artifact, not a per-finding record.",
      "items": {
        "type": "object",
        "required": ["id", "source_type", "location", "trust_level", "disposition"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "source_type": { "type": ["string", "null"] },
          "location": { "type": ["string", "null"] },
          "variable": { "type": ["string", "null"] },
          "entry_point": { "type": ["string", "null"] },
          "trust_level": { "type": ["string", "null"] },
          "disposition": { "type": ["string", "null"], "description": "covered | uncovered | null (unreconciled)" },
          "disposition_evidence": { "type": ["string", "null"] }
        }
      }
    },
    "coverage": {
      "type": "object",
      "description": "Consolidated coverage disclosure (4.7). Merges the F1 input ledger, the 4.3 run_summary tasks/findings breakdowns, and the F6 catch-all sweep/drop counts into one object so an operator sees, in one place, what was and wasn't covered. Injected from the run state by report.py — optional and permissive (additionalProperties allowed) so it never blocks report emission or a future field addition.",
      "properties": {
        "inputs_enumerated": { "type": "integer", "minimum": 0 },
        "inputs_covered": { "type": "integer", "minimum": 0 },
        "inputs_uncovered": { "type": "integer", "minimum": 0 },
        "tasks_by_source": { "type": "object", "description": "Task count keyed by source (recon, catchall, reconcile, ...)." },
        "findings_by_status": { "type": "object", "description": "Finding count keyed by validation_status (confirmed, false_positive, null=unvalidated, ...)." },
        "source_files": { "type": "integer", "minimum": 0, "description": "Eligible source files seen by the F6 catch-all sweep." },
        "covered_files": { "type": "integer", "minimum": 0, "description": "Of source_files, how many were already targeted by some task before the sweep." },
        "catchall_tasks": { "type": "integer", "minimum": 0, "description": "Catch-all sweep tasks queued." },
        "catchall_dropped": { "type": "integer", "minimum": 0, "description": "Eligible files the sweep could NOT queue because build_catchall_tasks's max_tasks cap was hit — coverage is INCOMPLETE whenever this is > 0." },
        "coverage_complete": { "type": "boolean", "description": "False when catchall_dropped > 0 or any enumerated input never reached a disposition. Never imply full coverage when this is false." }
      }
    }
  }
}
