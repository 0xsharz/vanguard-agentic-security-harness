{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ChainAnalysis",
  "type": "object",
  "required": ["summary", "chains"],
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "finding_ids", "severity", "narrative"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string" },
          "finding_ids": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "info"] },
          "blocked_by_controls": { "type": "array", "items": { "type": "string" } },
          "narrative": { "type": "string" }
        }
      }
    }
  }
}
